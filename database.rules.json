{
  "rules": {
    "mypayments": {
      "people": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true",
        "$personId": {
          ".read": "auth != null && (auth.token.admin === true || auth.token.personId === $personId)"
        }
      },
      "ledgers": {
        ".read": "auth != null && auth.token.admin === true",
        "$personId": {
          ".read": "auth != null && (auth.token.admin === true || auth.token.personId === $personId)",
          ".write": "auth != null && auth.token.admin === true"
        }
      },
      "transactions": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "security": {
      ".read": false,
      ".write": false
    }
  }
}
